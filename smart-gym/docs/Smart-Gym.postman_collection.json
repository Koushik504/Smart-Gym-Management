    {
      "name": "4. Synthetic member workflow (writes)",
      "description": "Run in order. Creates a uniquely named demonstration member, updates it, then deactivates it. Existing members are not modified.",
      "item": [
        {
          "name": "Create own synthetic member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Demo {{$randomUUID}}\",\n  \"email\": \"api-{{$randomUUID}}@smartgym.local\",\n  \"goal\": \"Strength\",\n  \"trainerId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", () =\u003e pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const member = pm.response.json(); pm.collectionVariables.set(\"createdMemberId\", member.id); pm.collectionVariables.set(\"createdMemberEmail\", member.email); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Read created member",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/members/{{createdMemberId}}"
          }
        },
        {
          "name": "Update created member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/members/{{createdMemberId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated API Demo\",\n  \"email\": \"{{createdMemberEmail}}\",\n  \"goal\": \"Mobility\",\n  \"trainerId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Deactivate created member",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/members/{{createdMemberId}}"
          }
        }
      ]
    },
