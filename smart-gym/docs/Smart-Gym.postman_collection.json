{
  "info": {
    "name": "Smart Gym - Live APIs",
    "description": "Smart Gym APIs organized like CricketLens: feature reads and separate /api/admin management writes. Set adminPassword, run Login first, and retain the cookie jar. The synthetic member workflow creates/deactivates only its own demonstration record. A separate member-login folder demonstrates personal reads; set memberPassword before running it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3100"
    },
    {
      "key": "adminEmail",
      "value": "admin@smartgym.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "trainerId",
      "value": "1"
    },
    {
      "key": "createdMemberId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": "member@smartgym.local"
    },
    {
      "key": "memberPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{baseUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () =\u003e pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
