{
  "name": "smart-gym",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "format": "prettier --write app components lib scripts database/mongodb tests *.ts *.mjs *.json --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-member": "tsx scripts/seed-member.ts",
    "db:check": "tsx scripts/check.ts",
    "db:audit": "tsx scripts/final-audit.ts",
    "db:demo": "tsx scripts/demo-queries.ts",
    "db:backup": "tsx scripts/backup.ts",
    "outbox": "tsx scripts/outbox.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.553.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.15.3",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
