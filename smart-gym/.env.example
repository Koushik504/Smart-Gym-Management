# URL-encode special characters in user/password. Use a dedicated MySQL account.
DATABASE_URL=mysql://smart_gym_user:CHANGE_ME@127.0.0.1:3306/smart_gym
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=smart_gym
APP_ORIGIN=http://127.0.0.1:3100
# Set true when APP_ORIGIN uses production HTTPS.
COOKIE_SECURE=false
# Synthetic LOCAL accounts only; choose passwords before running the seed.
SEED_ADMIN_PASSWORD=LocalAdmin!2026
SEED_TRAINER_PASSWORD=LocalTrainer!2026
SEED_MEMBER_PASSWORD=LocalMember!2026
