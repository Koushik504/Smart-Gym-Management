{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check Smart Gym database",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/start.ps1",
        "-DatabaseOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run Smart Gym",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/start.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
